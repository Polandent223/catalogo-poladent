rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/catalogAdmins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/catalogAdmins/$(request.auth.uid)).data.active == true;
    }
    match /catalog-images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if isAdmin();
    }
  }
}
